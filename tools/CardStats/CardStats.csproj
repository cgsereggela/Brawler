<Project Sdk="Microsoft.NET.Sdk">
  <!-- Card balance report from the game stats log. Run: dotnet run (see README for options) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../godot/scripts/Logic/**/*.cs" Link="Logic/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
